{
  "name": "audiodeity_simple",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "docs": "typedoc --logLevel Verbose",
    "preview": "vite preview",
    "dev:extension": "cross-env BUILD_TARGET=extension vite",
    "build:npm": "tsc && vite build",
    "build:extension": "cross-env BUILD_TARGET=extension vite build",
    "build:all": "npm run build:npm && npm run build:extension",
    "lint": "eslint . --ignore-pattern '**/bundle/**'",
    "lint:debug": "cross-env TIMING=1 eslint .",
    "prettier": "prettier --write .",
    "prepare": "husky",
    "test": "playwright test",
    "test:unit": "playwright test --grep @unit",
    "test:e2e": "playwright test --grep @e2e",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "typedoc": "^0.28.20",
    "typescript": "<7",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": "prettier --write",
    "*.{js,ts,jsx,tsx}": "eslint --fix"
  }
}
